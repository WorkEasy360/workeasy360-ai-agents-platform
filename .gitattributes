# Scripts, templates, SQL, YAML and env files run or are read on Linux: never check them out with CRLF
# (Windows line endings break bash scripts on the server).
* text=auto
*.sh        text eol=lf
*.template  text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
Dockerfile  text eol=lf
.env*       text eol=lf
