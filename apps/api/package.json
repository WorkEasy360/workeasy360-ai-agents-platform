{
  "name": "@we360/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,worker -c blue,magenta \"pnpm dev:api\" \"pnpm dev:worker\"",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "admin:create": "tsx --env-file=../../.env src/scripts/create-admin.ts",
    "dev:api": "tsx watch --env-file=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file=../../.env src/worker.ts",
    "start:worker": "node dist/worker.js",
    "demo:seed": "tsx --env-file=../../.env src/scripts/seed-demo.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/provider": "^4.0.21",
    "@aws-sdk/client-kms": "^3.1145.0",
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/client-sesv2": "^3.1145.0",
    "@node-rs/argon2": "^2.2.2",
    "@we360/db": "workspace:*",
    "ai": "^7.0.127",
    "ajv": "^8.20.0",
    "better-auth": "^1.7.7",
    "bullmq": "^6.3.11",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^10.5.0",
    "undici": "^7.30.0",
    "unpdf": "^1.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.4",
    "dotenv": "^16.6.1",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.3"
  }
}
