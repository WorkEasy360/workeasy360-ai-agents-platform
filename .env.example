# Copy to .env at the repo root for LOCAL DEVELOPMENT ONLY. Never commit .env.
# Production settings live only in deploy/.env on the server (template: deploy/.env.example).
# The API refuses to start in production if KMS_KEY_ID or API_KEY_PEPPER is missing, or if a local-only
# switch (LOCAL_MASTER_KEY, MOCK_LLM, ALLOW_PRIVATE_EGRESS, S3_ENDPOINT) is set.
#
# Generate random secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development

# --- URLs ---
# The browser talks to one origin: Next.js on :3000 proxies /api/* to the Express API on :4000.
APP_URL=http://localhost:3000
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000

# --- Database ---
# Local docker-compose Postgres, set up exactly like production (deploy/sql/01-create-roles-and-schema.sql):
# database `postgres`, schema `agents`; the API connects as agents_app (row-level security applies),
# the worker/admin/migrations as agents_owner (owns the schema).
DATABASE_URL=postgres://agents_app:agents_app@localhost:5433/postgres
DATABASE_URL_ADMIN=postgres://agents_owner:agents_owner@localhost:5433/postgres
DB_SCHEMA=agents

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth (Better Auth) ---
# [SECRET] Required. Signs sessions and encrypts 2FA secrets and OAuth tokens. The placeholder is rejected at startup.
BETTER_AUTH_SECRET=<generate-a-random-32-byte-value>
# [SECRET] Pepper for API-key hashes. Optional locally (falls back to BETTER_AUTH_SECRET);
# REQUIRED and different from BETTER_AUTH_SECRET in production.
API_KEY_PEPPER=
# Google sign-in (optional). GOOGLE_CLIENT_SECRET is [SECRET].
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email ---
# log: the worker prints every email (with its links) instead of sending it. Production uses SES
# (SES_REGION set, credentials from the EC2 instance role).
MAIL_TRANSPORT=log
MAIL_FROM=WorkEasy360 Agents <no-reply@localhost>
APP_TIMEZONE=Asia/Kolkata
# Sign-up is open in development; production defaults to invitation-only (ALLOW_PUBLIC_SIGNUP=false).

# --- Object storage (S3Mock locally, S3 in AWS) ---
S3_BUCKET=we360-agents-local
# Local emulator only. Unset in production.
S3_ENDPOINT=http://localhost:9090
S3_FORCE_PATH_STYLE=true

# --- Encryption of stored credentials and customer API keys ---
# [SECRET] Local only: a 32-byte base64 master key. Must be EMPTY in production.
LOCAL_MASTER_KEY=
# Production: the KMS key ARN (not a secret, but required).
KMS_KEY_ID=
AWS_REGION=ap-south-1

# --- Platform model keys [SECRET] (used when an org chooses "platform credits") ---
# Server-only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Privacy ---
# Audit log entries are deleted after this many days (IP address and browser are removed after 90).
AUDIT_RETENTION_DAYS=365

# --- Local development only (rejected in production) ---
# true = built-in mock model and embeddings, no provider keys needed.
MOCK_LLM=true
# true = API tools may call localhost/private IPs.
ALLOW_PRIVATE_EGRESS=false

# --- Web app (public, baked into the browser bundle: never put secrets here) ---
NEXT_PUBLIC_GOOGLE_LOGIN=false
