# Rendered by the nginx image's entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# Only ${DOMAIN} is substituted; nginx's own $variables pass through untouched.
#
# Single hostname: https://${DOMAIN}
#   /api/...        -> api:4000   REST API, auth, public chat/widget API (streams answers with SSE)
#   everything else -> web:3000   Next.js (app, hosted chat pages /c/..., widget frames /embed/...)

server_tokens off;

# Docker's embedded DNS. Upstreams are resolved per request (via the variables below),
# so nginx starts even if api/web are still starting and follows them across restarts.
resolver 127.0.0.11 valid=10s ipv6=off;

gzip on;
gzip_proxied any;
gzip_vary on;
gzip_min_length 1024;
# Not text/event-stream: compressing a stream buffers it and the chat would arrive in one piece.
gzip_types application/json application/javascript text/css text/plain image/svg+xml;

# --- :80 — ACME challenges, health, and a redirect for everything else --------------
server {
    listen 80 default_server;
    server_name ${DOMAIN} _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Container healthcheck (compose).
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# --- :443 --------------------------------------------------------------------------
server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Security headers (CSP, HSTS, X-Frame-Options, nosniff, Referrer-Policy) are set by the apps
    # themselves (helmet on the API, next.config.ts / proxy.ts on the web), so nginx adds none, to avoid
    # duplicated or conflicting values (widget frames need a per-deployment frame-ancestors).

    # Knowledge base uploads are capped at 20 MB by the API; leave room for the multipart envelope.
    client_max_body_size 25m;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    # Overwrite, don't append: the API trusts exactly one proxy hop (TRUST_PROXY_HOPS=1), so a client
    # can't spoof its address for rate limits by sending its own X-Forwarded-For.
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header Connection        "";

    set $api_upstream http://api:4000;
    set $web_upstream http://web:3000;

    location /api/ {
        # Chat answers stream as server-sent events: pass every chunk through as it arrives.
        proxy_buffering off;
        proxy_cache off;
        # Agent runs call models and tools, and document uploads are parsed: allow long requests.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass $api_upstream;
    }

    location / {
        proxy_read_timeout 60s;
        proxy_pass $web_upstream;
    }
}
