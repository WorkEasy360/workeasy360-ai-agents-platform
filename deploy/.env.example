# ---------------------------------------------------------------------------
# WorkEasy360 AI Agents: PRODUCTION environment for deploy/docker-compose.prod.yml
#
#   cp .env.example .env && chmod 600 .env
#
# Compose uses this file twice: for ${...} substitution in docker-compose.prod.yml, and as the
# environment of the api, worker and migrate containers (raw: values are taken literally, so don't
# quote them). Never commit .env. Lines marked [generate] get a fresh random value generated ON the
# server, with hex output so it needs no escaping anywhere:  openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- Host / compose ----------------------------------------------------------------
# The single public hostname. nginx serves the web app and /api/ on it; APP_URL is derived from it.
# No DNS yet? Use <ip-with-dashes>.sslip.io, e.g. 16-171-214-145.sslip.io
DOMAIN=agents.example.com
# Where Let's Encrypt sends expiry warnings.
LETSENCRYPT_EMAIL=workeasy360hq@gmail.com
# Set by deploy.sh to the running release (ghcr.io/<owner>/agents + commit sha).
IMAGE_PREFIX=ghcr.io/workeasy360/agents
IMAGE_TAG=latest

# --- Database: shared Aurora PostgreSQL, own schema + own roles --------------------
# Created by sql/01-create-roles-and-schema.sql (run once by the admin; see README.md).
#  - agents_app: the API. Row-level security applies. agents_owner: owns schema agents; worker + migrations.
#  - Both roles have search_path = agents, so every table lives in (and is read from) schema agents only.
#  - sslmode=verify-full: encrypted and the server certificate is checked (the image trusts the AWS RDS CA).
#    The cluster is in the same region and VPC as the server, so traffic stays inside AWS.
#  - Always the WRITER (cluster) endpoint. Database `postgres` (the shared one).
DATABASE_URL=postgres://agents_app:REPLACE_APP_PASSWORD@my-cluster.cluster-xxxxxxxx.eu-north-1.rds.amazonaws.com:5432/postgres?sslmode=verify-full
DATABASE_URL_ADMIN=postgres://agents_owner:REPLACE_OWNER_PASSWORD@my-cluster.cluster-xxxxxxxx.eu-north-1.rds.amazonaws.com:5432/postgres?sslmode=verify-full
DB_SCHEMA=agents
# Connection pool sizes are set per service in docker-compose.prod.yml (they must fit the roles' limits).

# --- Authentication ---------------------------------------------------------------
# [generate] two different values
BETTER_AUTH_SECRET=replace-me-openssl-rand-hex-32
API_KEY_PEPPER=replace-me-another-openssl-rand-hex-32
# false: only people with a pending invitation can create an account (create your own admin account with
# scripts/create-admin, then invite people from Settings → Members). true opens public sign-up.
ALLOW_PUBLIC_SIGNUP=false
# Platform staff must use two-factor authentication.
ADMIN_REQUIRE_2FA=true

# --- AWS (credentials come from the EC2 instance role; no access keys) ------------
AWS_REGION=eu-north-1
# KMS key (ARN) that encrypts the API keys and credentials customers store. Required.
KMS_KEY_ID=arn:aws:kms:eu-north-1:123456789012:key/REPLACE_KEY_ID
# Private S3 bucket for uploaded knowledge documents. Required.
S3_BUCKET=replace-me-agents-documents

# --- Email: Amazon SES -------------------------------------------------------------
# Leave SES_REGION commented out until the sender is verified in SES (and, for sending to anyone, the
# account is out of the SES sandbox). Without it: no emails; new accounts don't need verification, admins
# copy invitation links from Settings → Members, and platform admins can create password reset links.
# MAIL_TRANSPORT=log prints emails to the worker log instead (testing only: the log then holds sign-in links).
# SES_REGION=eu-north-1
MAIL_FROM=WorkEasy360 Agents <no-reply@workeasy360.com>
# Times in emails and the nightly maintenance schedule.
APP_TIMEZONE=Asia/Kolkata

# --- Platform model keys (used when an organization chooses "platform credits") ----
# Leave empty to require every organization to add its own key (BYOK).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Optional -----------------------------------------------------------------------
# Google sign-in: GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (and build the web image with NEXT_PUBLIC_GOOGLE_LOGIN=true).
LOG_LEVEL=info
