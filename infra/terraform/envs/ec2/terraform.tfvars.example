aws_region            = "ap-south-1"
environment           = "prod"
instance_id           = "i-0123456789abcdef0"
instance_role_name    = "" # existing role name, or empty to create one
documents_bucket_name = "we360-agents-prod-documents-<unique-suffix>"
github_repository     = "WorkEasy360/workeasy360-ai-agents-platform"
github_environment    = "production"
create_oidc_provider  = true # false if the account already has the GitHub OIDC provider
