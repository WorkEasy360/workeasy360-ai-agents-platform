# HTTPS with an automatic Let's Encrypt certificate for $DOMAIN (its DNS A record must point at this instance).
{$DOMAIN} {
	# The API is reached directly; streaming chat responses (SSE) are flushed as they arrive.
	handle /api/* {
		reverse_proxy api:4000 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy web:3000
	}

	request_body {
		max_size 60MB
	}
	header -Server
	log {
		output stdout
		format json
	}
}
